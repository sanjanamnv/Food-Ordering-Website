# ===============================================================
# FoodNest - Environment Variables Configuration Template
# For Windows (PowerShell): $env:MONGODB_URI="mongodb+srv://..."
# For Windows (CMD):        set MONGODB_URI=mongodb+srv://...
# For Linux/macOS (.env):   export MONGODB_URI=mongodb+srv://...
# ===============================================================

# Server Port
PORT=8080

# 1. MongoDB Atlas Connection
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-address>/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://foodnest_user:StrongPassword123@cluster0.abcde.mongodb.net/foodnest_db?retryWrites=true&w=majority
MONGODB_DATABASE=foodnest_db

# 2. Redis Cloud Connection
# Get these details from Redis Cloud Console -> Configuration -> General
REDIS_HOST=redis-12345.c256.us-east-1-2.ec2.redislabs.com
REDIS_PORT=12345
REDIS_USERNAME=default
REDIS_PASSWORD=YourRedisCloudPasswordHere
REDIS_SSL_ENABLED=false

# 3. JWT Secret Key (Minimum 256-bit hexadecimal string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 4. Redis Caching TTL Configuration (in seconds)
CACHE_RESTAURANTS_TTL=600
CACHE_MENU_TTL=600
CACHE_REC_TTL=300

# 5. Database Auto-Seeding (Populates sample Indian restaurants and foods on initial boot)
SEED_DATA_ENABLED=true
